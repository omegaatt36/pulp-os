    assert_eq!(s.ui_font_size_idx, 2);
    assert_eq!(s.reading_theme, 1);
    assert!(!s.swap_buttons);
    let (p, w) = parse(b"");
    assert_eq!(p.sleep_timeout, s.sleep_timeout);
    assert_eq!(p.reading_theme, s.reading_theme);
    assert!(!w.has_credentials());
}

