pub enum Phase {
    Loading,
    Ready,
    Toc,
    Error,
}

pub fn phase(a: &ReaderApp) -> Phase {
    match a.state {
        State::Ready => Phase::Ready,
        State::ShowToc => Phase::Toc,
        State::Error => Phase::Error,
        _ => Phase::Loading,
    }
}

